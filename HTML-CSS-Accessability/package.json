{
  "name": "plantme",
  "version": "1.0.0",
  "description": "A clean, modern plant store website built with HTML5, SCSS, and JS.",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel watch serve",
    "watch": "sass --watch src/scss/main.scss dist/css/main.css",
    "build": "sass src/scss/main.scss dist/css/main.css --style=compressed",
    "serve": "live-server --port=3000"
  },
  "author": "Margarita",
  "license": "MIT",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.0",
    "live-server": "^1.2.2"
  }
}
